# CMC — the MCP server (mcp.coinmarketcap.com) accepts the same pro-API key;
# CMC_MCP_KEY is optional and falls back to CMC_REST_KEY automatically.
CMC_MCP_KEY=<optional, falls back to CMC_REST_KEY>
CMC_REST_KEY=<from pro.coinmarketcap.com>

# x402 (backtest data only, not hot path)
X402_WALLET_PRIVATE_KEY=<Base account funded with USDC on Base>
X402_FACILITATOR_URL=https://x402.org/facilitator

# BSC Testnet
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_RPC_BACKUP_1=https://data-seed-prebsc-2-s1.binance.org:8545
BSC_TESTNET_RPC_BACKUP_2=https://bsc-testnet.publicnode.com
EXECUTOR_PRIVATE_KEY=<testnet-only wallet, never mainnet>
MEGAFUEL_POLICY_ID=<from 
# Canonical ERC-8004 IdentityRegistry on BSC Testnet (official bnb-chain/erc-8004-contracts proxy)
ERC8004_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e

# LLM (explainer only, temp=0)
OPENAI_API_KEY=<optional, only populates the description field>
LLM_SEED=42

# Service
EXECUTOR_PORT=8080
DASHBOARD_PORT=8501
DUCKDB_PATH=/data/stratfile.duckdb
LOG_LEVEL=INFO
